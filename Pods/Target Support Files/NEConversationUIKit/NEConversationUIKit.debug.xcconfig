APPLICATION_EXTENSION_API_ONLY = NO
BUILD_LIBRARY_FOR_DISTRIBUTION = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
CONFIGURATION_BUILD_DIR = ${PODS_CONFIGURATION_BUILD_DIR}/NEConversationUIKit
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/NEChatKit" "${PODS_ROOT}/NECommonKit" "${PODS_ROOT}/NECommonUIKit" "${PODS_ROOT}/NEConversationUIKit" "${PODS_ROOT}/NECoreIM2Kit" "${PODS_ROOT}/NECoreKit" "${PODS_ROOT}/NIMSDK_LITE/NIMSDK" "${PODS_ROOT}/YXAlog" "${PODS_ROOT}/YXArtemis_XCFramework" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NEChatKit/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NECommonKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NECommonUIKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NEConversationUIKit/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NECoreIM2Kit/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NECoreKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NIMSDK_LITE/FTS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NIMSDK_LITE/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/YXArtemis_XCFramework"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS -import-underlying-module -Xcc -fmodule-map-file="${SRCROOT}/${MODULEMAP_FILE}"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_DEVELOPMENT_LANGUAGE = ${DEVELOPMENT_LANGUAGE}
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/NEConversationUIKit
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
SWIFT_INCLUDE_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/NEChatKit" "${PODS_CONFIGURATION_BUILD_DIR}/NECommonKit" "${PODS_CONFIGURATION_BUILD_DIR}/NECommonUIKit" "${PODS_CONFIGURATION_BUILD_DIR}/NECoreIM2Kit" "${PODS_CONFIGURATION_BUILD_DIR}/NECoreKit"
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
