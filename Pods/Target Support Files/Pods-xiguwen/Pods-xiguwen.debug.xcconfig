ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
ARCHS = $(ARCHS_STANDARD)
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/AMap2DMap" "${PODS_ROOT}/AMapFoundation" "${PODS_ROOT}/AMapLocation" "${PODS_ROOT}/AMapSearch" "${PODS_ROOT}/AlipaySDK-iOS" "${PODS_ROOT}/BmobSDK" "${PODS_ROOT}/JCore" "${PODS_ROOT}/JPush" "${PODS_ROOT}/NEChatKit" "${PODS_ROOT}/NEChatUIKit" "${PODS_ROOT}/NECommonKit" "${PODS_ROOT}/NECommonUIKit" "${PODS_ROOT}/NEContactUIKit" "${PODS_ROOT}/NEConversationUIKit" "${PODS_ROOT}/NECoreIM2Kit" "${PODS_ROOT}/NECoreKit" "${PODS_ROOT}/NIMSDK_LITE/NIMSDK" "${PODS_ROOT}/UMCommon/UMCommon_7.5.8" "${PODS_ROOT}/UMDevice/UMDevice_3.5.0" "${PODS_ROOT}/UMShare/UMShare" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/QQ/QQSDK" "${PODS_ROOT}/UMShare/UMShare/UMSocialUI" "${PODS_ROOT}/YXAlog" "${PODS_ROOT}/YXArtemis_XCFramework" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AlipaySDK-iOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NEChatKit/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NEChatUIKit/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NECommonKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NECommonUIKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NEContactUIKit/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NEConversationUIKit/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NECoreIM2Kit/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NECoreKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NIMSDK_LITE/FTS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/NIMSDK_LITE/NOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/UMCommon" "${PODS_XCFRAMEWORKS_BUILD_DIR}/UMDevice" "${PODS_XCFRAMEWORKS_BUILD_DIR}/YXArtemis_XCFramework"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1 $(inherited) SD_WEBP=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/AFNetworking" "${PODS_ROOT}/Headers/Public/CocoaLumberjack" "${PODS_ROOT}/Headers/Public/DOPDropDownMenu-Enhanced" "${PODS_ROOT}/Headers/Public/DZNEmptyDataSet" "${PODS_ROOT}/Headers/Public/FMDB" "${PODS_ROOT}/Headers/Public/FSCalendar" "${PODS_ROOT}/Headers/Public/HCSStarRatingView" "${PODS_ROOT}/Headers/Public/HMQRCodeScanner" "${PODS_ROOT}/Headers/Public/IQKeyboardManager" "${PODS_ROOT}/Headers/Public/MBProgressHUD" "${PODS_ROOT}/Headers/Public/MJExtension" "${PODS_ROOT}/Headers/Public/MJRefresh" "${PODS_ROOT}/Headers/Public/PPGetAddressBook" "${PODS_ROOT}/Headers/Public/QMUIKit" "${PODS_ROOT}/Headers/Public/RDVTabBarController" "${PODS_ROOT}/Headers/Public/Reachability" "${PODS_ROOT}/Headers/Public/ReactiveObjC" "${PODS_ROOT}/Headers/Public/SDAutoLayout" "${PODS_ROOT}/Headers/Public/SDWebImage" "${PODS_ROOT}/Headers/Public/SDWebImageSVGKitPlugin" "${PODS_ROOT}/Headers/Public/SDWebImageWebPCoder" "${PODS_ROOT}/Headers/Public/SGNavigationProgress" "${PODS_ROOT}/Headers/Public/SSZipArchive" "${PODS_ROOT}/Headers/Public/SVGKit" "${PODS_ROOT}/Headers/Public/TTTAttributedLabel" "${PODS_ROOT}/Headers/Public/TZImagePickerController" "${PODS_ROOT}/Headers/Public/UMShare" "${PODS_ROOT}/Headers/Public/UPPaymentControl" "${PODS_ROOT}/Headers/Public/WMPageController" "${PODS_ROOT}/Headers/Public/WechatOpenSDK" "${PODS_ROOT}/Headers/Public/libwebp" "${PODS_XCFRAMEWORKS_BUILD_DIR}/JCore/Headers" "${PODS_XCFRAMEWORKS_BUILD_DIR}/JPush/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "${PODS_CONFIGURATION_BUILD_DIR}/CocoaLumberjack" "${PODS_CONFIGURATION_BUILD_DIR}/DOPDropDownMenu-Enhanced" "${PODS_CONFIGURATION_BUILD_DIR}/DZNEmptyDataSet" "${PODS_CONFIGURATION_BUILD_DIR}/FMDB" "${PODS_CONFIGURATION_BUILD_DIR}/FSCalendar" "${PODS_CONFIGURATION_BUILD_DIR}/HCSStarRatingView" "${PODS_CONFIGURATION_BUILD_DIR}/HMQRCodeScanner" "${PODS_CONFIGURATION_BUILD_DIR}/IQKeyboardManager" "${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD" "${PODS_CONFIGURATION_BUILD_DIR}/MJExtension" "${PODS_CONFIGURATION_BUILD_DIR}/MJRefresh" "${PODS_CONFIGURATION_BUILD_DIR}/PPGetAddressBook" "${PODS_CONFIGURATION_BUILD_DIR}/QMUIKit" "${PODS_CONFIGURATION_BUILD_DIR}/RDVTabBarController" "${PODS_CONFIGURATION_BUILD_DIR}/Reachability" "${PODS_CONFIGURATION_BUILD_DIR}/ReactiveObjC" "${PODS_CONFIGURATION_BUILD_DIR}/SDAutoLayout" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImageSVGKitPlugin" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImageWebPCoder" "${PODS_CONFIGURATION_BUILD_DIR}/SGNavigationProgress" "${PODS_CONFIGURATION_BUILD_DIR}/SSZipArchive" "${PODS_CONFIGURATION_BUILD_DIR}/SVGKit" "${PODS_CONFIGURATION_BUILD_DIR}/TTTAttributedLabel" "${PODS_CONFIGURATION_BUILD_DIR}/TZImagePickerController" "${PODS_CONFIGURATION_BUILD_DIR}/WMPageController" "${PODS_CONFIGURATION_BUILD_DIR}/libwebp" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/QQ" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/Sina" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/Sina/SinaSDK" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/WeChat" "${PODS_ROOT}/UPPaymentControl" "${PODS_ROOT}/WechatOpenSDK/OpenSDK2.0.5" "${PODS_XCFRAMEWORKS_BUILD_DIR}/JCore" "${PODS_XCFRAMEWORKS_BUILD_DIR}/JPush" "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift "$(PODS_ROOT)/UPPaymentControl/**"
OTHER_LDFLAGS = $(inherited) -ObjC -l"AFNetworking" -l"CocoaLumberjack" -l"DOPDropDownMenu-Enhanced" -l"DZNEmptyDataSet" -l"FMDB" -l"FSCalendar" -l"HCSStarRatingView" -l"HMQRCodeScanner" -l"IQKeyboardManager" -l"JCore" -l"JPush" -l"MBProgressHUD" -l"MJExtension" -l"MJRefresh" -l"PPGetAddressBook" -l"PaymentControl" -l"QMUIKit" -l"RDVTabBarController" -l"Reachability" -l"ReactiveObjC" -l"SDAutoLayout" -l"SDWebImage" -l"SDWebImageSVGKitPlugin" -l"SDWebImageWebPCoder" -l"SGNavigationProgress" -l"SSZipArchive" -l"SVGKit" -l"SocialQQ" -l"SocialSina" -l"SocialWeChat" -l"TTTAttributedLabel" -l"TZImagePickerController" -l"WMPageController" -l"WechatOpenSDK" -l"WeiboSDK" -l"c++" -l"icucore" -l"libwebp" -l"resolv" -l"sqlite3" -l"sqlite3.0" -l"xml2" -l"z" -l"z.1.2.5" -framework "AMapFoundationKit" -framework "AMapLocationKit" -framework "AMapSearchKit" -framework "AVFoundation" -framework "AlipaySDK" -framework "AudioToolbox" -framework "BmobSDK" -framework "CFNetwork" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CoreImage" -framework "CoreLocation" -framework "CoreMedia" -framework "CoreMotion" -framework "CoreServices" -framework "CoreTelephony" -framework "CoreText" -framework "Foundation" -framework "ImageIO" -framework "MAMapKit" -framework "MobileCoreServices" -framework "NEChatKit" -framework "NEChatUIKit" -framework "NECommonKit" -framework "NECommonUIKit" -framework "NEContactUIKit" -framework "NEConversationUIKit" -framework "NECoreIM2Kit" -framework "NECoreKit" -framework "NIMDBEx" -framework "NIMNOS" -framework "NIMQuic" -framework "NIMSDK" -framework "NIMSocketRocket" -framework "Photos" -framework "PhotosUI" -framework "QuartzCore" -framework "Security" -framework "SystemConfiguration" -framework "TencentOpenAPI" -framework "UIKit" -framework "UMCommon" -framework "UMDevice" -framework "UMShare" -framework "UShareUI" -framework "VideoToolbox" -framework "WebKit" -framework "YXAlog_iOS" -framework "YXArtemis" -weak_framework "AppTrackingTransparency" -weak_framework "Network" -weak_framework "UserNotifications"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
SWIFT_INCLUDE_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/NEChatKit" "${PODS_CONFIGURATION_BUILD_DIR}/NEChatUIKit" "${PODS_CONFIGURATION_BUILD_DIR}/NECommonKit" "${PODS_CONFIGURATION_BUILD_DIR}/NECommonUIKit" "${PODS_CONFIGURATION_BUILD_DIR}/NEContactUIKit" "${PODS_CONFIGURATION_BUILD_DIR}/NEConversationUIKit" "${PODS_CONFIGURATION_BUILD_DIR}/NECoreIM2Kit" "${PODS_CONFIGURATION_BUILD_DIR}/NECoreKit"
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
