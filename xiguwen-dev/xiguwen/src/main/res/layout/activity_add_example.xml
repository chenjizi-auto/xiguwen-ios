<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/ll_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:background="@color/colorBg">
        <com.linzi.xiguwen.view.CusScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/white"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="婚礼名称"/>
                    <EditText
                        android:id="@+id/ed_name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:textSize="15sp"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:hint="请输入名称"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:id="@+id/ll_choose_time"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/menu_click_selector"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="婚礼时间"/>
                    <TextView
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:textSize="15sp"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:inputType="number|phone"
                        android:hint="请选择"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@mipmap/icon_next_step"
                        android:layout_marginLeft="8dp"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="婚礼场地"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/ed_changdi"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:textSize="15sp"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:hint="请输入婚礼场地"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/white"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="婚礼费用"/>
                    <EditText
                        android:id="@+id/ed_dingjing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:textSize="15sp"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:inputType="number|phone"
                        android:hint="请输入费用"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:id="@+id/ll_wedding_type"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/menu_click_selector"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="婚礼类型"/>
                    <TextView
                        android:id="@+id/ed_type"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:hint="请输入婚礼类型"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:background="@mipmap/icon_next_step"/>

                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:id="@+id/ll_wedding_environment"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/menu_click_selector"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="婚礼环境"/>
                    <TextView
                        android:id="@+id/ed_huanjing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:hint="请输入婚礼环境"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:background="@mipmap/icon_next_step"/>

                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/white"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="婚礼排序"/>
                    <EditText
                        android:id="@+id/ed_weight"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:textSize="15sp"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:inputType="number|phone"
                        android:hint="请输入排序"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:id="@+id/ll_choose_fengmian"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/menu_click_selector">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="婚礼封面"/>
                    <ImageView
                        android:id="@+id/iv_fengmian"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@mipmap/icon_placeholder"
                        android:scaleType="centerCrop"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:background="@mipmap/icon_next_step"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:gravity="top"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="婚礼描述"/>
                    <EditText
                        android:id="@+id/ed_wmiaoshu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:layout_marginBottom="16dp"
                        android:textSize="15sp"
                        android:lines="4"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:gravity="top"
                        android:hint="请输入婚礼描述…"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:background="@color/white"
                    android:descendantFocusability="blocksDescendants">
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/recycle"></androidx.recyclerview.widget.RecyclerView>
                </RelativeLayout>
            </LinearLayout>
        </com.linzi.xiguwen.view.CusScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="@color/white"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/ll_save"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#FFBF56">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="保存"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
