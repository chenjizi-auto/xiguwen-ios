<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/ll_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:background="@color/colorBg">
        <com.linzi.xiguwen.view.CusScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/white"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="视频名称"/>
                    <EditText
                        android:id="@+id/ed_name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:textSize="15sp"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:hint="请输入名称"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/white"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="视频类型"/>

                    <com.linzi.xiguwen.view.UISwitchButton
                        android:id="@+id/sb_video_type"
                        android:layout_width="51dp"
                        android:layout_height="31dp"
                        android:checked="true"/>

                    <TextView
                        android:id="@+id/tv_video_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="外链"/>

                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:id="@+id/ll_video_url"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/white"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="视频链接"/>
                    <EditText
                        android:id="@+id/ed_web_http"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:layout_marginLeft="8dp"
                        android:textSize="15sp"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:hint="请输入链接"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:id="@+id/ll_choose_fengmian"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/menu_click_selector"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="视频封面"/>
                    <ImageView
                        android:id="@+id/iv_fengmian"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@mipmap/icon_placeholder"
                        android:scaleType="centerCrop"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:background="@mipmap/icon_next_step"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:id="@+id/ll_choose_vadio"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/menu_click_selector"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:text="上传视频"/>
                    <RelativeLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/iv_vadio"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@mipmap/icon_placeholder"
                            android:scaleType="centerCrop"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@mipmap/icon_vadio_img"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:background="@mipmap/icon_next_step"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="视频排序"
                        android:textColor="@color/colorTitle"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/ed_weight"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="请输入排序"
                        android:inputType="number|phone"
                        android:textColor="@color/colorHint"
                        android:textColorHint="@color/colorHint"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </com.linzi.xiguwen.view.CusScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="@color/white"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/ll_save"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#FFBF56">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="保存"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
