<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.linzi.xiguwen.ui.BindPhoneActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:background="@color/colorBg">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:paddingRight="16dp"
            android:layout_marginTop="16dp">
            <EditText
                android:id="@+id/ed_phone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:inputType="phone|number"
                android:hint="请输入手机号码"/>
            <Button
                android:id="@+id/bt_get_code"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:background="@color/colorMain"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:text="获取验证码"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/colorBg"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:paddingRight="16dp">
            <EditText
                android:id="@+id/ed_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:inputType="phone|number"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:hint="请输入验证码"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="vertical"
            android:visibility="invisible"
            android:gravity="center">
            <TextView
                android:id="@+id/tv_to_guestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/colorTitleRed"
                android:text="绑定遇到问题？"/>
        </LinearLayout>

        <Button
            android:id="@+id/bt_next_step"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:background="@drawable/login_bt_selector"
            android:textColor="@drawable/login_txt_selector"
            android:text="立即绑定"/>'

    </LinearLayout>
</LinearLayout>
