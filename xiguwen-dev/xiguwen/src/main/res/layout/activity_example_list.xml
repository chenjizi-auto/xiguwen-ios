<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.linzi.xiguwen.ui.ExampleListActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/ll_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingRight="16dp"
            android:background="@color/white">
            <LinearLayout
                android:id="@+id/ll_back"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/menu_click_selector">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/icon_back"/>
            </LinearLayout>
            <EditText
                android:id="@+id/ed_search"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:hint="小清新婚礼"
                android:textSize="15sp"
                android:textColorHint="@color/colorHint"
                android:drawableLeft="@mipmap/ic_search"
                android:background="@drawable/index_search_edit_window"
                android:drawablePadding="8dp"
                android:paddingLeft="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_group"
            android:layout_width="match_parent"
            android:layout_height="44.5dp"
            android:orientation="vertical"
            android:background="@color/white">
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/colorHint"/>
            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <com.linzi.xiguwen.view.CusRadioButton
                    android:id="@+id/rb_all"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:textColor="@drawable/arrow_txt_selector"
                    android:textSize="14sp"
                    android:text="类型"
                    android:gravity="center"
                    android:clickable="true"
                    app:drawableRight="@drawable/icon_arrow_selector"
                    app:rbdrawableSize="8dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"/>
                <com.linzi.xiguwen.view.CusRadioButton
                    android:id="@+id/rb_location"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:textColor="@drawable/arrow_txt_selector"
                    android:textSize="14sp"
                    android:text="环境"
                    android:gravity="center"
                    android:clickable="true"
                    app:rbdrawableSize="8dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    app:drawableRight="@drawable/icon_arrow_selector"/>
                <com.linzi.xiguwen.view.CusRadioButton
                    android:id="@+id/rb_sort"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:textColor="@drawable/arrow_txt_selector"
                    android:textSize="14sp"
                    android:text="综合排序"
                    android:gravity="center"
                    android:clickable="true"
                    app:rbdrawableSize="8dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    app:drawableRight="@drawable/icon_arrow_selector"/>
                <com.linzi.xiguwen.view.CusRadioButton
                    android:id="@+id/rb_saixuan"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:textColor="@drawable/arrow_txt_selector"
                    android:textSize="14sp"
                    android:text="筛选"
                    android:gravity="center"
                    app:rbdrawableSize="8dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:clickable="true"
                    app:drawableRight="@mipmap/icon_saixuan"/>
            </RadioGroup>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/colorHint"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/hot_recycle"></androidx.recyclerview.widget.RecyclerView>
            </RelativeLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
