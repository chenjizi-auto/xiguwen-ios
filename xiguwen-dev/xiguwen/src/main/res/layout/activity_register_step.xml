<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.linzi.xiguwen.ui.RegisterStepActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="选择商家类型"
            android:textColor="@color/colorTitle"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/rb_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:button="@null"
            android:drawablePadding="5dp"
            android:drawableTop="@drawable/selector_register_step_one"
            android:gravity="center_horizontal"
            android:text="本地婚礼服务"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <!--<TextView-->
        <!--android:layout_width="wrap_content"-->
        <!--android:layout_height="wrap_content"-->
        <!--android:text="本地婚礼服务"-->
        <!--android:textColor="@color/colorTitle"-->
        <!--android:textSize="15sp" />-->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:layout_marginTop="10dp"
            android:text="提供婚礼策划、婚纱摄影、摄影师、摄像师、化妆师、主持人、婚纱礼服、婚宴酒店、婚戒首饰、花艺甜品等服务。"
            android:textColor="@color/g_999999"
            android:textSize="12sp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/rb_mall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:button="@null"
            android:drawablePadding="5dp"
            android:drawableTop="@drawable/selector_register_step_two"
            android:gravity="center_horizontal"
            android:text="婚品电商"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:layout_marginTop="10dp"
            android:text="可发布各类婚礼商品，包括但不限于：婚纱、礼服、婚鞋、配饰、首饰、婚庆用品、家居礼品等。"
            android:textColor="@color/g_999999"
            android:textSize="12sp" />

        <Button
            android:id="@+id/bt_next"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="32dp"
            android:background="@drawable/login_bt_selector"
            android:text="下一步"
            android:textColor="@drawable/login_txt_selector"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_marginTop="30dp"
        android:padding="15dp"
        android:src="@mipmap/login_close_icon" />

</RelativeLayout>
