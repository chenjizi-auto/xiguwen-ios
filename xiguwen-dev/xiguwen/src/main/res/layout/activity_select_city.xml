<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.linzi.xiguwen.ui.SelectCityActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:orientation="vertical"
            android:background="@color/white"
            android:gravity="center">
            <EditText
                android:id="@+id/ed_search"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/index_search_edit_window"
                android:hint="输入城市名/拼音查询"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:textSize="16sp"
                android:textColorHint="@color/colorHint"
                android:drawableLeft="@mipmap/ic_search"
                android:drawablePadding="8dp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ListView
                android:id="@+id/main_lv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:divider="@null"
                android:scrollbars="none"
                />
            <TextView
                android:id="@+id/dialog"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="#496491"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="@android:color/white"
                android:visibility="invisible"
                />
            <!-- 自定义字母导航栏 -->
            <com.linzi.xiguwen.view.SideBar
                android:id="@+id/side_bar"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="30dp"
                android:layout_gravity="right|center"
                app:paddingStart="20dp"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
