<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/ll_parent"
    tools:context="com.linzi.xiguwen.ui.TodayAddTeamActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:paddingRight="16dp"
            android:paddingLeft="16dp"
            android:background="@color/white">
            <Button
                android:id="@+id/bt_last_day"
                android:layout_width="70dp"
                android:layout_height="28dp"
                android:textSize="13sp"
                android:textColor="@drawable/login_txt_selector"
                android:background="@drawable/login_bt_selector"
                android:text="上一天"/>
            <TextView
                android:id="@id/tv_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/main_red"
                android:text="0000年00月00日"/>
            <Button
                android:id="@+id/bt_next_day"
                android:layout_width="70dp"
                android:layout_height="28dp"
                android:textSize="13sp"
                android:textColor="@drawable/login_txt_selector"
                android:background="@drawable/login_bt_selector"
                android:text="下一天"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/recycle"
                android:visibility="visible"></androidx.recyclerview.widget.RecyclerView>
            <LinearLayout
                android:id="@+id/ll_nodata"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/icon_today_add_empty"/>
                <TextView
                    android:id="@+id/tv_nodata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#b3b3b3"
                    android:text="等待，为了更美好的事发生~"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
