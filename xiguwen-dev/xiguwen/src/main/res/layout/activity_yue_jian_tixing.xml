<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/ll_parent"
    tools:context="com.linzi.xiguwen.ui.CaiPaiTixingActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:background="@color/colorBg">
        <com.linzi.xiguwen.view.CusScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/ll_hl_date"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/menu_click_selector">
                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:textSize="16sp"
                        android:textColor="@color/colorTitle"
                        android:text="婚礼时间"/>
                    <TextView
                        android:id="@+id/ed_hunli_time"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:textColorHint="@color/colorHint"
                        android:textSize="14sp"
                        android:gravity="center_vertical"
                        android:background="@android:color/transparent"
                        android:hint="请输入婚礼时间"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:id="@+id/ll_address"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:gravity="center_vertical"
                    android:background="@color/white">
                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:textSize="16sp"
                        android:textColor="@color/colorTitle"
                        android:text="约见地点"/>
                    <EditText
                        android:id="@+id/ed_address"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:textColorHint="@color/colorHint"
                        android:textSize="14sp"
                        android:background="@android:color/transparent"
                        android:hint="请输入约见地点"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:id="@+id/ll_date"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/menu_click_selector">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textSize="16sp"
                        android:textColor="@color/colorTitle"
                        android:text="约见时间"/>
                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/colorHint"
                        android:text="0000年00月00日"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@mipmap/icon_next_step"
                        android:layout_marginLeft="8dp"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>

                <EditText
                    android:id="@+id/ed_beizhu"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:padding="16dp"
                    android:background="@color/white"
                    android:gravity="top"
                    android:textSize="14sp"
                    android:textColorHint="@color/colorHint"
                    android:hint="请输入您的备注…"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:layout_marginTop="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:paddingRight="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/colorTitle"
                        android:text="提醒（一）"/>
                    <TextView
                        android:id="@+id/tv_notice_time_1"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:textSize="14sp"
                        android:hint="手机当前时间"
                        android:textColor="@color/colorHint"/>
                    <com.linzi.xiguwen.view.UISwitchButton
                        android:id="@+id/sb_notice_1"
                        android:layout_width="51dp"
                        android:layout_height="31dp"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/colorBg"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingLeft="16dp"
                    android:gravity="center_vertical"
                    android:paddingRight="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/colorTitle"
                        android:text="提醒（二）"/>
                    <TextView
                        android:id="@+id/tv_notice_time_2"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/colorHint"
                        android:hint="手机当前时间"
                        />
                    <com.linzi.xiguwen.view.UISwitchButton
                        android:id="@+id/sb_notice_2"
                        android:layout_width="51dp"
                        android:layout_height="31dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/bt_submit"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="vertical"
                    android:background="@color/main_red"
                    android:layout_margin="32dp"
                    android:textColor="@color/white"
                    android:text="保存提醒"
                    android:gravity="center">
                </Button>

            </LinearLayout>
        </com.linzi.xiguwen.view.CusScrollView>
    </LinearLayout>
</LinearLayout>
