<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="vertical"
            android:background="@color/white"
            android:gravity="center">
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/colorTitle"
                    android:text="购物车"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0.2dp"
            android:background="@color/colorHint"/>
        <com.linzi.xiguwen.view.CusScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:descendantFocusability="blocksDescendants">
                                <LinearLayout
                                    android:id="@+id/ll_no_data"
                                    android:layout_width="match_parent"
                                    android:layout_height="248dp"
                                    android:orientation="vertical"
                                    android:visibility="gone"
                                    android:gravity="center">
                                        <ImageView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:src="@mipmap/icon_cart_nogoods"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="24dp"
                                            android:textColor="#b3b3b3"
                                            android:textSize="14sp"
                                            android:text="您的购物车时空的哦"/>
                                </LinearLayout>
                                <com.yanzhenjie.recyclerview.swipe.SwipeMenuRecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:id="@+id/recycle"></com.yanzhenjie.recyclerview.swipe.SwipeMenuRecyclerView>
                        </RelativeLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:orientation="horizontal"
                            android:background="#F0F0F0"
                            android:gravity="center"
                            android:paddingLeft="100dp"
                            android:paddingRight="100dp">
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0.5dp"
                                    android:background="@color/red_color"
                                    android:layout_marginRight="8dp"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="为你推荐"
                                    android:textColor="@color/red_color"/>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0.5dp"
                                    android:layout_marginLeft="8dp"
                                    android:background="@color/red_color"
                                    android:layout_weight="1"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:descendantFocusability="blocksDescendants">
                                <com.yanzhenjie.recyclerview.swipe.SwipeMenuRecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:id="@+id/recycle2"
                                    android:paddingLeft="4dp"
                                    android:paddingRight="4dp"></com.yanzhenjie.recyclerview.swipe.SwipeMenuRecyclerView>
                        </RelativeLayout>
                </LinearLayout>
        </com.linzi.xiguwen.view.CusScrollView>
        <View
            android:layout_width="match_parent"
            android:layout_height="0.2dp"
            android:background="@color/colorHint"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:gravity="center_vertical">
                <CheckBox
                    android:id="@+id/cb_all"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:button="@null"
                    android:background="@drawable/icon_pay_radio_selector"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="全选"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:gravity="center_vertical|right">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="合计："/>
                        <TextView
                            android:id="@id/tv_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0000"
                            android:textSize="18sp"
                            android:textColor="@color/colorTitleRed"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_jiesuan"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:orientation="vertical"
                    android:background="@color/colorTitleRed"
                    android:gravity="center">
                        <TextView
                            android:id="@+id/tv_to_jiesuan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:text="去结算"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
