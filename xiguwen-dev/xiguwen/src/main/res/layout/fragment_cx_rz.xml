<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent">
    <com.linzi.xiguwen.view.CusScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:gravity="center_vertical"
                android:background="@color/white">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/icon_rz_cx"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/tv_rz_one"
                        android:layout_width="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:text="诚信认证1"/>
                    <TextView
                        android:id="@+id/tv_notice_chuji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/colorHint"
                        android:text=""/>
                </LinearLayout>
                <Button
                    android:id="@+id/bt_to_rz_one"
                    android:layout_width="70dp"
                    android:layout_height="28dp"
                    android:textColor="@color/main_red"
                    android:background="@drawable/shape_baojia_windows"
                    android:textSize="13sp"
                    android:text="立即认证"/>
                <TextView
                    android:id="@+id/tv_is_rz_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/main_red"
                    android:visibility="gone"
                    android:textSize="13sp"
                    android:text="已认证"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/colorBg"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:gravity="center_vertical"
                android:background="@color/white">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/icon_rz_cx"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/tv_rz_two"
                        android:layout_width="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:text="诚信认证2"/>
                    <TextView
                        android:id="@+id/tv_notice_zhongji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/colorHint"
                        android:text=""/>
                </LinearLayout>
                <Button
                    android:id="@+id/bt_to_rz_two"
                    android:layout_width="70dp"
                    android:layout_height="28dp"
                    android:textColor="@color/main_red"
                    android:background="@drawable/shape_baojia_windows"
                    android:textSize="13sp"
                    android:text="立即认证"/>
                <TextView
                    android:id="@+id/tv_is_rz_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/main_red"
                    android:visibility="gone"
                    android:textSize="13sp"
                    android:text="已认证"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/colorBg"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:gravity="center_vertical"
                android:background="@color/white">
                <ImageView
                    android:id="@+id/iv_rz_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/icon_rz_cx"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/tv_rz_three"
                        android:layout_width="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:text="诚信认证3"/>
                    <TextView
                        android:id="@+id/tv_notice_jinguan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/colorHint"
                        android:text=""/>
                </LinearLayout>
                <Button
                    android:id="@+id/bt_to_rz_three"
                    android:layout_width="70dp"
                    android:layout_height="28dp"
                    android:textColor="@color/main_red"
                    android:background="@drawable/shape_baojia_windows"
                    android:textSize="13sp"
                    android:text="立即认证"/>
                <TextView
                    android:id="@+id/tv_is_rz_three"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/main_red"
                    android:visibility="gone"
                    android:textSize="13sp"
                    android:text="已认证"/>
            </LinearLayout>
        </LinearLayout>
    </com.linzi.xiguwen.view.CusScrollView>
</LinearLayout>