<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="93dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="93dp"
        android:orientation="vertical"
        android:background="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">
            <androidx.cardview.widget.CardView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:orientation="vertical"
                android:background="@color/colorHint"
                android:gravity="center"
                android:layout_marginRight="8dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:cardCornerRadius="5dp">
                <ImageView
                    android:id="@+id/iv_img"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_list_image_bg"
                    android:clipToOutline="true"
                    android:outlineProvider="background"
                    android:src="@mipmap/icon_placeholder"/>
            </androidx.cardview.widget.CardView>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/iv_rz"
                    android:layout_width="20dp"
                    android:layout_height="26dp"
                    android:layout_alignParentRight="true"
                    android:background="@mipmap/icon_vip"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/tv_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="@color/colorTitle"
                            android:text="商户名"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/tv_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="@color/colorTitleRed"
                            android:text="0"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:layout_marginLeft="24dp"
                            android:gravity="center_vertical"
                            android:layout_weight="1">
                            <ImageView
                                android:id="@+id/iv_rz_cx"
                                android:layout_width="28dp"
                                android:layout_height="18dp"
                                android:background="@mipmap/icon_rz_cx"
                                android:layout_marginRight="8dp"/>
                            <ImageView
                                android:id="@+id/iv_rz_pt"
                                android:layout_width="28dp"
                                android:layout_height="18dp"
                                android:background="@mipmap/icon_rz_pt"
                                android:layout_marginRight="8dp"/>
                            <ImageView
                                android:id="@+id/iv_rz_xy"
                                android:layout_width="28dp"
                                android:layout_height="18dp"
                                android:background="@mipmap/icon_rz_xy"
                                android:layout_marginRight="8dp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_zhiwu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:layout_marginLeft="16dp"
                            android:textColor="@color/title_sign"
                            android:text="职务"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/tv_hp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/title_sign"
                            android:text="好评率 100%"/>

                        <TextView
                            android:id="@+id/tv_pl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textColor="@color/title_sign"
                            android:layout_marginLeft="36dp"
                            android:text="评论 233"/>

                        <TextView
                            android:id="@+id/tv_fens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/title_sign"
                            android:layout_marginLeft="36dp"
                            android:text="粉丝 30"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/f0f0f0"
            android:layout_marginLeft="100dp"/>
    </LinearLayout>
</LinearLayout>
