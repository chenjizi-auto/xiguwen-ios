<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp">

        <ImageView
            android:id="@+id/notice_icon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/notice_image"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@color/color_gray_bfc2c5"
            android:layout_alignParentRight="true"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/notice_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_toRightOf="@id/notice_icon"
            android:text="bane"
            android:textColor="#FF3C97C8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notice_name_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@id/notice_name"
            android:text="bane"
            android:textColor="#262626"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notice_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
           android:layout_marginRight="55dp"
            android:layout_below="@id/notice_name"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:layout_toRightOf="@id/notice_icon"
            android:text="bane"
            android:textColor="#999999"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notice_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/notice_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="8dp"
            android:layout_toRightOf="@id/notice_icon"
            android:text="bane"
            android:textColor="#999999"
            android:textSize="12sp" />
    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:background="#e2e2e2"
        android:layout_marginLeft="75dp"
        android:layout_height="1px"/>

</LinearLayout>