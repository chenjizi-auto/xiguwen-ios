<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:gravity="bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:background="@color/colorBg"
        android:orientation="horizontal"
        android:paddingTop="0.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:gravity="center"
                android:id="@+id/bt_one"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="1"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>

            <TextView
                android:gravity="center"
                android:id="@+id/bt_four"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="4"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>

            <TextView
                android:gravity="center"
                android:id="@+id/bt_seven"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="7"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>

            <TextView
                android:gravity="center"
                android:id="@+id/bt_point"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="."
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>
        </LinearLayout>

        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:gravity="center"
                android:id="@+id/bt_two"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="2"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>

            <TextView
                android:gravity="center"
                android:id="@+id/bt_five"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="5"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>

            <TextView
                android:gravity="center"
                android:id="@+id/bt_eight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="8"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>

            <TextView
                android:gravity="center"
                android:id="@+id/bt_zero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="0"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>
        </LinearLayout>

        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:gravity="center"
                android:id="@+id/bt_three"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="3"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>

            <TextView
                android:gravity="center"
                android:id="@+id/bt_six"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="6"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>


            <TextView
                android:gravity="center"
                android:id="@+id/bt_nine"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/menu_click_selector"
                android:text="9"
                android:textColor="@color/colorTitle"
                android:textSize="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>

            <LinearLayout
                android:id="@+id/ll_hide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/menu_click_selector">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/icon_keybord_down"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/ll_del"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/menu_click_selector"
                android:gravity="center"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/icon_keybord_del"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:id="@+id/ll_submit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/colorMain"
                android:gravity="center"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:text="确定"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>