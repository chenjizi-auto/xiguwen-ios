<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <RadioGroup
        android:id="@+id/radiogroup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <com.linzi.xiguwen.view.CusRadioButton
            android:id="@+id/rb_all"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@null"
            android:clickable="true"
            android:gravity="center"
            android:lines="1"
            android:paddingLeft="5dp"
            android:paddingRight="16dp"
            android:text="综合排序"
            android:textColor="@drawable/arrow_txt_selector"
            android:textSize="14sp" />

        <com.linzi.xiguwen.view.CusRadioButton
            android:id="@+id/rb_salenum"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@null"
            android:clickable="true"
            android:gravity="center"
            android:lines="1"
            android:paddingLeft="5dp"
            android:paddingRight="16dp"
            android:text="销量"
            android:textColor="@drawable/arrow_txt_selector"
            android:textSize="14sp" />

        <com.linzi.xiguwen.view.CusRadioButton
            android:id="@+id/rb_price"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@null"
            android:clickable="true"
            android:gravity="center"
            android:lines="1"
            android:paddingLeft="5dp"
            android:paddingRight="16dp"
            android:text="价格"
            app:rbdrawableSize="8dp"
            android:textColor="@drawable/arrow_txt_selector"
            android:textSize="14sp" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/f0f0f0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycle"
            android:overScrollMode="never"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include layout="@layout/nodata_text_layout" />
    </LinearLayout>
</LinearLayout>